# PostgreSQL – zwei Rollen (siehe docs/PLAN.md 3.1)
# Besitzerrolle: Migrationen
DATABASE_URL_OWNER=postgres://vermieteros_owner:owner@127.0.0.1:5432/vermieteros
# App-Rolle: Laufzeit, ohne BYPASSRLS, ohne UPDATE/DELETE auf Ledger-Tabellen
DATABASE_URL=postgres://vermieteros_app:app@127.0.0.1:5432/vermieteros
# Worker (apps/worker) nutzt DATABASE_URL mit der Rolle vermieteros_worker:
# postgres://vermieteros_worker:worker@127.0.0.1:5432/vermieteros

# Object Storage (lokal rclone serve s3, prod Hetzner Object Storage)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=eu-central
S3_BUCKET=vermieteros
S3_ACCESS_KEY=dev
S3_SECRET_KEY=dev-geheim

# Postfach-Passwörter (Web verschlüsselt, Worker entschlüsselt): openssl rand -base64 32
POSTFACH_SCHLUESSEL=

# KI (WP 1.4): ohne Schlüssel ist die KI aus, alles andere läuft. Modell nur nach Golden-Set-Lauf ändern.
ANTHROPIC_API_KEY=
KI_MODELL=
# Worker sortiert neue Mails automatisch (aus: KI_SORTIERUNG=aus), höchstens so viele pro Durchlauf
KI_SORTIERUNG=
KI_SORTIERUNG_LIMIT=20

# Mailversand (WP 1.10). Lokal an GreenMail (ops/testdienste.sh), Mails ansehen per IMAP 3143.
# Leer = nichts wird verschickt, der Inhalt steht im Server-Log.
SMTP_HOST=
SMTP_PORT=3025
SMTP_TLS=aus
MAIL_ABSENDER=

# Better Auth
BETTER_AUTH_SECRET=change-me-32-bytes-min
BETTER_AUTH_URL=http://localhost:3000
# Nur lokal: 2FA-Pflicht und Rate-Limit abschalten (nie in Produktion)
# ZWEI_FAKTOR_PFLICHT=aus
# AUTH_RATE_LIMIT=aus

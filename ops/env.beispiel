# Vorlage für /srv/vermieteros/.env auf dem Server (chmod 600). Nie committen.
# Passwörter nur aus [0-9a-f] erzeugen, sie stehen in Verbindungs-URLs: openssl rand -hex 24

DOMAIN=www.vermieteros.app
# Leitet dauerhaft auf DOMAIN um (eigener DNS-Eintrag nötig); leer = keine Umleitung
DOMAIN_UMLEITUNG=vermieteros.app
TAG=sha-0000000
# IMAGE_APP=ghcr.io/mfilkorn-stack/vermieteros
# IMAGE_OPS=ghcr.io/mfilkorn-stack/vermieteros-ops

POSTGRES_PASSWORT=
VOS_OWNER_PASSWORT=
VOS_APP_PASSWORT=
VOS_WORKER_PASSWORT=
VOS_SICHERUNG_PASSWORT=

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Wer ein Konto anlegen darf: diese Adressen (kommagetrennt) und Eingeladene. Sonst niemand.
REGISTRIERUNG_ERLAUBT=

# Schlüssel für Postfach-Passwörter (Web verschlüsselt, Worker entschlüsselt): openssl rand -base64 32
# Geht er verloren, müssen alle Postfach-Passwörter neu eingegeben werden.
POSTFACH_SCHLUESSEL=

# Verantwortlicher für die Datenschutzinformation unter /datenschutz (Pflicht vor echten Mieterdaten)
DATENSCHUTZ_VERANTWORTLICHER=
DATENSCHUTZ_ANSCHRIFT=
DATENSCHUTZ_EMAIL=

# Adresssuche in Formularen über Photon (OpenStreetMap, komoot). Es geht nur der Suchtext raus,
# vom Server, ohne Nutzerbezug. ADRESSSUCHE=aus schaltet ab; ADRESSSUCHE_URL für einen eigenen Photon-Server.
ADRESSSUCHE=
ADRESSSUCHE_URL=

# KI (WP 1.4): ohne Schlüssel ist die KI aus, alles andere läuft. Modell nur nach Golden-Set-Lauf ändern.
ANTHROPIC_API_KEY=
KI_MODELL=
# Worker sortiert neue Mails automatisch (aus: KI_SORTIERUNG=aus), höchstens so viele pro Durchlauf
KI_SORTIERUNG=
KI_SORTIERUNG_LIMIT=20
# Worker liest neue Belege aus, höchstens so viele pro Durchlauf
KI_BELEGE_LIMIT=10

# Mailversand (WP 1.10) über SMTP, anbieterneutral (docs/BETRIEB.md, „Mailversand“).
# Leer = kein Versand (Einladungslinks erscheinen dann zum Weitergeben in der App).
SMTP_HOST=
SMTP_PORT=587
SMTP_BENUTZER=
SMTP_PASSWORT=
MAIL_ABSENDER="Vermieter.OS <noreply@vermieteros.app>"

# Hetzner Object Storage für Mails und Anhänge (Worker schreibt, Web lädt herunter, Backup liest mit)
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
ABRUF_INTERVALL_SEKUNDEN=300

# Hetzner Object Storage, eigener Bucket nur für Backups
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BACKUP_BUCKET=
S3_BACKUP_ACCESS_KEY=
S3_BACKUP_SECRET_KEY=

# age-Public-Key(s), durch Leerzeichen getrennt. Der private Schlüssel liegt offline (docs/BETRIEB.md).
BACKUP_EMPFAENGER=

# Totmannschalter (healthchecks.io oder selbst gehostet), je Job eine URL. Leer = nur Log.
HEALTHCHECK_BACKUP=
HEALTHCHECK_INTEGRITAET=
HEALTHCHECK_RESTORE=
HEALTHCHECK_ABRUF=
